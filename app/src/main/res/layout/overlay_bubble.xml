<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/bubbleButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bubble_bg"
        android:contentDescription="Open live chat"
        android:padding="11dp"
        android:src="@drawable/ic_ball" />

    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp">

        <View
            android:id="@+id/dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_bg"
            android:backgroundTint="#8A8A8A" />

        <TextView
            android:id="@+id/counterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="-- connected"
            android:textColor="#EFEAE7"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
